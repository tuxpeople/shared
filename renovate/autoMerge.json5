{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Auto merge GitHub Actions",
      "matchManagers": ["github-actions"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["minor", "patch", "digest"]
    },
    {
      "description": "Auto merge others",
      "automerge": true,
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "Reusable workflows of this repository: PR checks do not run them, so review by hand",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["tuxpeople/shared"],
      "automerge": false
    }
  ]
}
